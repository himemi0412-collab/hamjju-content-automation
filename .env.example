# --- Required ---
OPENAI_API_KEY=
NOTION_ACCESS_TOKEN=
FAL_KEY=

# Existing Notion data source IDs found in your workspace
BLOG_DATA_SOURCE_ID=21a60556-f086-4b7a-96b3-81995c77edef
SHORTS_DATA_SOURCE_ID=e7ad07b7-0652-4747-956d-e7b071d4bde9

# --- OpenAI models ---
TEXT_MODEL=gpt-5.6-luna
QA_MODEL=gpt-5.6-luna
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
TTS_MODEL=fal-ai/gemini-3.1-flash-tts
TTS_VOICE=Aoede
TTS_PPOJJUGI_VOICE=Aoede
TTS_JAPAN_VOICE=Gacrux
FAL_TTS_TEMPERATURE=1.1
FAL_TTS_PPOJJUGI_LANGUAGE=Korean (South Korea)
FAL_TTS_JAPAN_LANGUAGE=Japanese (Japan)

# --- Safety / cost controls ---
MAX_JOBS_PER_RUN=3
# Keep paid automatic retries small. Blog failures are resumed explicitly so
# five card images are not regenerated as a side effect of one QA rejection.
AUTO_RETRY_MAX_ATTEMPTS=1
AUTO_RETRY_BLOG_ENABLED=false
ENABLE_WEB_RESEARCH=true
ENABLE_MEDIA_GENERATION=false
AUTO_PRIVATE_YOUTUBE_UPLOAD=false
ALLOW_PUBLIC_YOUTUBE_UPLOAD=false
TTS_JAPAN_VOICE=Gacrux
# Add only voices that were listened to and approved. Blank means unavailable.
TTS_JAPAN_YOUNG_WOMAN_VOICE=
TTS_JAPAN_YOUNG_MAN_VOICE=
TTS_JAPAN_OLDER_MAN_VOICE=
OPENAI_MONTHLY_BUDGET_USD=22
OPENAI_BUDGET_LEDGER=output/openai-cost-ledger.json
OPENAI_BUDGET_REQUIRE_EXISTING_LEDGER=false

# --- YouTube (optional; private uploads only) ---
YOUTUBE_CLIENT_SECRETS_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# --- Runtime ---
STATE_DB=output/state.db
OUTPUT_DIR=output
LOG_LEVEL=INFO
